    <worksheet name='Sponsor Ranking'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Top 15 IPF/PF Sponsors by Phase-Weighted Trial Score</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Boehringer Ingelheim leads IPF/PF trial activity by a wide margin (45 trials, phase-weighted score of 86), reflecting its ownership of nintedanib. Notably, several of the most active sponsors — including Boehringer Ingelheim itself — are privately or family-owned, not publicly traded, which is factored into the color coding above and directly informs which sponsors will be trackable in the companion Earnings Surprise Tracker project.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sponsor_ranking' name='federated.0xsw0qp036c2es19w64e00pi8p97' />
          </datasources>
          <datasource-dependencies datasource='federated.0xsw0qp036c2es19w64e00pi8p97'>
            <column-instance column='[publicly_traded]' derivation='None' name='[none:publicly_traded:nk]' pivot='key' type='nominal' />
            <column-instance column='[sponsor_name]' derivation='None' name='[none:sponsor_name:nk]' pivot='key' type='nominal' />
            <column caption='Phase Weighted Score' datatype='integer' name='[phase_weighted_score]' role='measure' type='quantitative' />
            <column caption='Publicly Traded' datatype='boolean' name='[publicly_traded]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Private/Academic' />
                <alias key='true' value='Publicly Traded' />
              </aliases>
            </column>
            <column caption='Sponsor Name' datatype='string' name='[sponsor_name]' role='dimension' type='nominal' />
            <column-instance column='[phase_weighted_score]' derivation='Sum' name='[sum:phase_weighted_score:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xsw0qp036c2es19w64e00pi8p97].[none:sponsor_name:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([phase_weighted_score])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:sponsor_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0xsw0qp036c2es19w64e00pi8p97].[none:sponsor_name:nk]' direction='DESC' using='[federated.0xsw0qp036c2es19w64e00pi8p97].[sum:phase_weighted_score:qk]' />
          <filter class='quantitative' column='[federated.0xsw0qp036c2es19w64e00pi8p97].[sum:phase_weighted_score:qk]' included-values='in-range' />
          <slices>
            <column>[federated.0xsw0qp036c2es19w64e00pi8p97].[sum:phase_weighted_score:qk]</column>

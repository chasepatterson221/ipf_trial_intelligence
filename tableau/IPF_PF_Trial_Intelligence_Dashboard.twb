                <alias key='&quot;comparator&quot;' value='Comparator/Control' />
                <alias key='&quot;endothelin_receptor_antagonist&quot;' value='Endothelin Receptor Antagonist' />
                <alias key='&quot;immunosuppressant&quot;' value='Immunosuppressant' />
                <alias key='&quot;investigational_unclassified&quot;' value='Investigational (Unclassified)' />
                <alias key='&quot;pde_inhibitor&quot;' value='PDE Inhibitor' />
                <alias key='&quot;repurposed_other&quot;' value='Repurposed Drug' />

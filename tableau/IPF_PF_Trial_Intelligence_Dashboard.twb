  <worksheets>
    <worksheet name='Mechanism Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Antifibrotic: The Mechanism Class That Performs at Scale</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Antifibrotic-mechanism trials combine strong performance (35.3% reach Phase 3+, 86.4% complete rather than terminate) with the largest reliable sample size (n=85) among established mechanism classes — consistent with antifibrotics being the only mechanism validated by FDA-approved IPF drugs. Categories like Endothelin Receptor Antagonist show higher raw percentages but on samples too small (n=7) to be statistically reliable.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mechanism_success_rates' name='federated.0baa8vw000lggz1clcpc309lxm5i' />
          </datasources>
          <datasource-dependencies datasource='federated.0baa8vw000lggz1clcpc309lxm5i'>
            <column caption='Completion Rate Pct' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[completion_rate_pct]' role='measure' type='quantitative' />

    <worksheet name='Risk Scores'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Highest Termination Risk: Top 15 Active IPF/PF Trials</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>A logistic regression model (ROC AUC 0.63, trained on 229 resolved trials) scored all 100 currently-active IPF/PF trials for termination risk. The highest-risk trials skew toward later phases (Phase 2/3), where efficacy is actually tested at scale — consistent with the Phase 3 attrition seen in the funnel view. Model performance is modest given the limited size of the training set (50 terminated trials), an honest constraint of small clinical trial datasets.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='risk_scores' name='federated.06zff0l1gsy7jm137ob991ntnilu' />
          </datasources>
          <datasource-dependencies datasource='federated.06zff0l1gsy7jm137ob991ntnilu'>
            <column-instance column='[brief_title]' derivation='Attribute' name='[attr:brief_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[phase]' derivation='Attribute' name='[attr:phase:nk]' pivot='key' type='nominal' />
            <column-instance column='[sponsor_name]' derivation='Attribute' name='[attr:sponsor_name:nk]' pivot='key' type='nominal' />
            <column caption='Brief Title' datatype='string' name='[brief_title]' role='dimension' type='nominal' />
            <column caption='Nct Id' datatype='string' name='[nct_id]' role='dimension' type='nominal' />
            <column-instance column='[nct_id]' derivation='None' name='[none:nct_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[phase]' derivation='None' name='[none:phase:nk]' pivot='key' type='nominal' />
            <column caption='Phase' datatype='string' name='[phase]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;PHASE2&quot;' value='Phase 2' />
                <alias key='&quot;PHASE3&quot;' value='Phase 3' />
              </aliases>
            </column>
            <column caption='Sponsor Name' datatype='string' name='[sponsor_name]' role='dimension' type='nominal' />
            <column-instance column='[termination_risk_score]' derivation='Sum' name='[sum:termination_risk_score:qk]' pivot='key' type='quantitative' />
            <column caption='Termination Risk Score' datatype='real' name='[termination_risk_score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.06zff0l1gsy7jm137ob991ntnilu].[none:nct_id:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([termination_risk_score])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:nct_id:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.06zff0l1gsy7jm137ob991ntnilu].[none:nct_id:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.06zff0l1gsy7jm137ob991ntnilu].[sum:termination_risk_score:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.06zff0l1gsy7jm137ob991ntnilu].[none:nct_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.06zff0l1gsy7jm137ob991ntnilu].[none:phase:nk]' />
              <text column='[federated.06zff0l1gsy7jm137ob991ntnilu].[sum:termination_risk_score:qk]' />
              <tooltip column='[federated.06zff0l1gsy7jm137ob991ntnilu].[attr:sponsor_name:nk]' />
              <tooltip column='[federated.06zff0l1gsy7jm137ob991ntnilu].[attr:phase:nk]' />
